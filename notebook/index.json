e phase diagram above updates.\nfig.set_setting(\"/page1/graph1/dens/colorMap\", \"plasma\")\nfig.set_setting(\"/page1/graph1/dens/numBinsX\", 80)\nfig.set_setting(\"/page1/graph1/dens/numBinsY\", 80)\nprint(\"redrew with\", 80, \"x\", 80, \"bins\")\n''')","key":"Ms3fQXQK26"},{"type":"outputs","id":"YtUCruLq_8wpZwpIfQ0tr","children":[],"key":"oXY2iV8O2k"}],"key":"pGDfrnyd6P"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Edit the whole document","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"rFKYSWkRlk"}],"identifier":"edit-the-whole-document","label":"Edit the whole document","html_id":"edit-the-whole-document","implicit":true,"key":"ysJ3Iz0aVb"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"text","value":"The settings tweak above is small; you can also edit the figure’s ","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"SVsGcD0D8q"},{"type":"strong","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"entire Veusz\ndocument","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"X3czGJClO8"}],"key":"n783Pdg85Y"},{"type":"text","value":" — add widgets, change axes, swap the plot type — and rebuild it on the\nsame data. Edit and ","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"Wkvl3Z1ydA"},{"type":"strong","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"Run","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"ywyCqLYBZU"}],"key":"yDrIa9kQSe"},{"type":"text","value":":","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"zsSZEyLMLl"}],"key":"eWLIOf1dRK"}],"key":"lSWeg6cx7p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"VeuszCodeEditor(r'''\n# The full Veusz document for the figure. Edit it and Run to rebuild `fig`\n# above — then re-feed the same kernel arrays (load resets the datasets).\ndoc = \"\"\"SetCompatLevel(0)\nAdd('page', name='page1', autoadd=False)\nTo('page1')\nAdd('graph', name='graph1', autoadd=False)\nTo('graph1')\nAdd('axis', name='x', autoadd=False)\nTo('x')\nSet('label', 'log \\\\\\\\rho')\nTo('..')\nAdd('axis', name='y', autoadd=False)\nTo('y')\nSet('label', 'log T')\nSet('direction', 'vertical')\nTo('..')\nAdd('density', name='dens', autoadd=False)\nTo('dens')\nSet('xData', 'logrho')\nSet('yData', 'logT')\nSet('numBinsX', 100)\nSet('numBinsY', 100)\nSet('colorMap', 'inferno')\nSet('colorScaling', 'log')\nTo('..')\n\"\"\"\nfig.load_vsz(doc)\nfig.set_data(\"logrho\", logrho)\nfig.set_data(\"logT\", logT)\nprint(\"rebuilt the figure from the document above\")\n''')","key":"n99ATxCDp2"},{"type":"outputs","id":"OY6EU1I0w6bOXxk8dKSN5","children":[],"key":"dazUS9a8FZ"}],"key":"zU9SvuwWH2"}],"key":"X4hXm3vWn1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"myst-veusz example — a browser-native lab notebook","url":"/readme","group":"Veusz figures in a browser-native MyST notebook"}}},"domain":"http://localhost:3000"}