ind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nrng = np.random.default_rng(7)\nn = 6000\nlogrho = np.concatenate([rng.normal(-1.0, 0.7, n), rng.normal(1.2, 0.4, n)])\nlogT   = np.concatenate([4.2 + 0.55*rng.normal(-1.0, 0.7, n) + rng.normal(0, 0.2, n),\n                         6.4 + rng.normal(0, 0.3, n)])\nprint(f\"{logrho.size:,} cells\")\nprint(f\"log rho in [{logrho.min():.2f}, {logrho.max():.2f}]\")\nprint(f\"log T   in [{logT.min():.2f}, {logT.max():.2f}]\")","key":"aEpgj8Ekol"},{"type":"outputs","id":"I1l7zcUR7U0lpoFqkEPHI","children":[],"key":"UfGb84f2ec"}],"key":"xx5dFnhI7a"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Plot, with Veusz","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"smPHSxOEYx"}],"identifier":"plot-with-veusz","label":"Plot, with Veusz","html_id":"plot-with-veusz","implicit":true,"key":"mhcqgPoD9H"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"The figure below is a ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"GlPhJ7SEYm"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"real, live Veusz ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"O6exUgxere"},{"type":"inlineCode","value":"density","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"hGamgSwo0U"},{"type":"text","value":" widget","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"kP8zm4sKI7"}],"key":"JkeWrnOpx5"},{"type":"text","value":" — a 2D histogram\n(phase diagram) of the two arrays computed above. It runs ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key"